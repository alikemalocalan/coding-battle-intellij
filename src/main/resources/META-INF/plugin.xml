<idea-plugin>
    <id>com.alikemal.code-stat-intellij</id>
    <name>Code::Stats</name>
    <vendor email="support@alikemal.com" url="https://github.com/alikemalocalan">Ali Kemal</vendor>

    <description><![CDATA[
    Code::Stats plugin for IntelliJ/JetBrains IDEs (2026+ compatible).
    Tracks typed characters per programming language and sends XP updates to Code::Stats servers.
    ]]></description>

    <depends>com.intellij.modules.lang</depends>

    <idea-version since-build="261"/>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.alikemal.codestat.CodeStatsSettings"/>
        <applicationService serviceImplementation="com.alikemal.codestat.CodeStatsService" preload="true"/>
        <applicationConfigurable instance="com.alikemal.codestat.ui.CodeStatsConfigurable" displayName="Code::Stats" groupId="tools"/>
        <statusBarWidgetFactory implementation="com.alikemal.codestat.ui.CodeStatsWidgetFactory" id="code-stats-intellij-status-bar-icon"/>
        <postStartupActivity implementation="com.alikemal.codestat.CodeStatsStartupActivity"/>
    </extensions>
</idea-plugin>